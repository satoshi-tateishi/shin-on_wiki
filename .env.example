# ============================================
# shin·on Wiki by BookStack - LINE WORKS SSO Configuration
# ============================================
# This is a customized configuration for shin·on Wiki by BookStack with LINE WORKS SSO integration.
# For detailed setup instructions, see: claude/docs/README_LINEWORKS.md
#
# This file, when named as ".env" in the root of your shin·on Wiki by BookStack install
# folder, is used for the core configuration of the application.
# By default this file contains the most common required options but
# a full list of options can be found in the '.env.example.complete' file.
#
# SETUP STEPS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Generate APP_KEY: php artisan key:generate
# 3. Configure LINE WORKS credentials (OIDC_CLIENT_ID, OIDC_CLIENT_SECRET)
# 4. Set LINEWORKS_DOMAIN to your LINE WORKS domain
# 5. Run database migrations: php artisan migrate
#
# For troubleshooting, see: claude/docs/LINEWORKS_SSO_SETUP.md

# NOTE: If any of your values contain a space or a hash you will need to
# wrap the entire value in quotes. (eg. MAIL_FROM_NAME="shin·on Wiki by BookStack Mailer")

# Application Environment
APP_ENV=local
APP_DEBUG=true

# Application key
# Used for encryption where needed.
# Run `php artisan key:generate` to generate a valid key.
APP_KEY=SomeRandomString

# Application URL
# This must be the root URL that you want to host shin·on Wiki by BookStack on.
# All URLs in shin·on Wiki by BookStack will be generated using this value
# to ensure URLs generated are consistent and secure.
# If you change this in the future you may need to run a command
# to update stored URLs in the database. Command example:
# php artisan bookstack:update-url https://old.example.com https://new.example.com
APP_URL=https://localhost:8443
APP_PORT=8083
VITE_PORT=5175

# Trusted Proxies Configuration
# Set to '*' to trust all proxies (required when behind reverse proxy like Apache/Nginx)
# For production environments behind a reverse proxy, this ensures HTTPS is correctly detected
# and URLs are generated with the correct protocol.
# Options: '*' (trust all), '**' (trust all + forwarded), or comma-separated IP addresses
APP_PROXIES=

# Application Language
APP_LANG=ja
APP_AUTO_LANG_PUBLIC=true
APP_TIMEZONE=Asia/Tokyo

# Forward ports for Docker
FORWARD_DB_PORT=3308
FORWARD_REDIS_PORT=6380
WWWUSER=1000
WWWGROUP=1000

# Database details
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=shin_on_wiki
DB_USERNAME=database_username
DB_PASSWORD=database_user_password

# Mail system to use
# Can be 'smtp' or 'sendmail'
MAIL_DRIVER=smtp

# Mail sender details
MAIL_FROM_NAME="shin·on Wiki by BookStack"
MAIL_FROM=bookstack@example.com

# SMTP mail options
# These settings can be checked using the "Send a Test Email"
# feature found in the "Settings > Maintenance" area of the system.
# For more detailed documentation on mail options, refer to:
# https://www.bookstackapp.com/docs/admin/email-webhooks/#email-configuration
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# ============================================
# LINE WORKS OpenID Connect (OIDC) Authentication
# ============================================
# For detailed setup instructions, see: claude/docs/README_LINEWORKS.md

# Authentication Method
# Set to 'oidc' to enable LINE WORKS SSO authentication
AUTH_METHOD=oidc

# OIDC Provider Name
# Display name shown on the login page
OIDC_NAME="LINE WORKS"

# OIDC Display Name Claims
# The claim from the ID token to use as the user's display name
OIDC_DISPLAY_NAME_CLAIMS=name

# OIDC Client Credentials
# Obtain these from LINE WORKS Admin Console > Developer Console
# https://admin.worksmobile.com/
OIDC_CLIENT_ID=your_lineworks_client_id
OIDC_CLIENT_SECRET=your_lineworks_client_secret

# OIDC Issuer
# LINE WORKS authentication server URL
OIDC_ISSUER=https://auth.worksmobile.com

# OIDC Discovery
# Set to false as we manually configure endpoints
OIDC_ISSUER_DISCOVER=false

# OIDC Public Key
# Leave empty - JWT signature validation is skipped for LINE WORKS
# (LINE WORKS does not provide JWKS endpoint)
OIDC_PUBLIC_KEY=

# OIDC Endpoints
# LINE WORKS OAuth 2.0 endpoints
OIDC_AUTH_ENDPOINT=https://auth.worksmobile.com/oauth2/v2.0/authorize
OIDC_TOKEN_ENDPOINT=https://auth.worksmobile.com/oauth2/v2.0/token

# OIDC Additional Scopes
# Additional OAuth 2.0 scopes (optional)
OIDC_ADDITIONAL_SCOPES=

# OIDC Group Sync
# Disable group synchronization
OIDC_USER_TO_GROUPS=false
OIDC_GROUPS_CLAIM=
OIDC_REMOVE_FROM_GROUPS=false

# OIDC Debug Mode
# Set to true to dump user details for debugging (NEVER use in production!)
OIDC_DUMP_USER_DETAILS=false

# ============================================
# LINE WORKS Domain Restriction
# ============================================
# Only users with email addresses from this domain can log in
# Example: If set to "shin-on1981", only users with @shin-on1981 emails can access
# This is a critical security feature - see claude/docs/LINEWORKS_SSO_SETUP.md
LINEWORKS_DOMAIN=shin-on1981

# ============================================
# LINE WORKS Bot API Settings (Two-Factor Authentication)
# ============================================
# For detailed setup instructions, see: claude/docs/LINEWORKS_OTP_2FA.md
#
# SETUP STEPS:
# 1. Create a Bot in LINE WORKS Developer Console
# 2. Create a Service Account and download the private key
# 3. Create a Developer Console App for Bot API access
# 4. Configure the values below
# 5. Place the private key at: storage/app/lineworks/private_key.pem

# LINE WORKS API Base URL (do not change)
LINEWORKS_API_BASE_URL=https://www.worksapis.com/v1.0

# LINE WORKS Auth URL (do not change)
LINEWORKS_AUTH_URL=https://auth.worksmobile.com/oauth2/v2.0/token

# Bot ID - Obtain from LINE WORKS Developer Console > Bot
LINEWORKS_BOT_ID=your_bot_id

# Bot Secret - Obtain from LINE WORKS Developer Console > Bot
LINEWORKS_BOT_SECRET=your_bot_secret

# Developer Console App Client ID - For Service Account authentication
LINEWORKS_DB_CLIENT_ID=your_developer_console_client_id

# Developer Console App Client Secret - For Service Account authentication
LINEWORKS_DB_CLIENT_SECRET=your_developer_console_client_secret

# Service Account ID - Format: xxxxx.serviceaccount@your-domain
LINEWORKS_SERVICE_ACCOUNT=your_service_account@your-domain

# Path to private key file (relative to storage/app/)
LINEWORKS_PRIVATE_KEY_PATH=lineworks/private_key.pem

# ============================================
# Dropbox Backup & Restore Configuration
# ============================================
# For detailed setup instructions, see: claude/docs/BACKUP_RESTORE.md

# Dropbox OAuth 2.0 Configuration
# Obtain these from Dropbox App Console: https://www.dropbox.com/developers/apps
# 1. Create a Dropbox app with "Scoped access" and "Full Dropbox" access
# 2. Set permissions: files.content.write, files.content.read, account_info.read
# 3. Add redirect URI: ${APP_URL}/auth/dropbox/callback
DROPBOX_CLIENT_ID=your_dropbox_app_key
DROPBOX_CLIENT_SECRET=your_dropbox_app_secret
DROPBOX_REDIRECT_URI="${APP_URL}/auth/dropbox/callback"

# Dropbox Backup Settings
# Folder path in Dropbox where backups will be stored (e.g., /shin-on_wiki-backup)
DROPBOX_BACKUP_FOLDER=/shin-on_wiki-backup

# Access token lifetime in seconds (default: 14400 = 4 hours)
DROPBOX_ACCESS_TOKEN_LIFETIME=14400

# Backup Configuration
# Timezone for backup timestamps (should match APP_TIMEZONE)
BACKUP_TIMEZONE=Asia/Tokyo

# Number of days to retain backups (older backups can be manually deleted)
BACKUP_RETENTION_DAYS=30
