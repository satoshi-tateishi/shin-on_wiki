# ============================================================
# shin•on Wiki by BookStack - 設定ファイルサンプル
# ============================================================
# このファイルを ".env" にコピーして使用してください。
# 設定項目の完全なリストは '.env.example.complete' を参照してください。
#
# セットアップ手順:
# 1. このファイルをコピー: cp .env.example .env
# 2. APP_KEY を生成: php artisan key:generate
# 3. shin•on Portal の PORTAL_* 変数を設定
# 4. DBマイグレーションを実行: php artisan migrate

# 注意: 値にスペースや#が含まれる場合はダブルクォートで囲んでください。
# （例: MAIL_FROM_NAME="BookStack Mailer"）

# =============================================================
# 環境切り替え方法
# =============================================================
#   開発環境 → 「開発環境用」の行を有効、「本番環境用」の行をコメントアウト
#   本番環境 → 「本番環境用」の行を有効、「開発環境用」の行をコメントアウト

# ============================================================
# アプリケーション基本設定
# ============================================================
APP_ENV=local          # 本番環境用: production
APP_DEBUG=true         # 本番環境用: false

# アプリケーションキー（暗号化に使用。`php artisan key:generate` で生成）
APP_KEY=SomeRandomString

# アプリケーションURL（URLを変更した場合は下記コマンドでDB内のURLも更新してください）
# php artisan bookstack:update-url https://old.example.com https://new.example.com
APP_URL=https://localhost:8443   # 本番環境用: https://wiki.shin-on1981.com
APP_PORT=8083
VITE_PORT=5175

# 言語・タイムゾーン
APP_LANG=ja
APP_AUTO_LANG_PUBLIC=true
APP_TIMEZONE=Asia/Tokyo

# ============================================================
# データベース設定
# ============================================================
DB_HOST=127.0.0.1   # 本番環境用: db
DB_PORT=3308        # 本番環境用: 3306
DB_DATABASE=shin_on_wiki
DB_USERNAME=database_username
DB_PASSWORD=database_user_password

# Dockerポートフォワード設定
FORWARD_DB_PORT=3308
FORWARD_REDIS_PORT=6380
WWWUSER=1000
WWWGROUP=1000

# ============================================================
# ストレージ設定
# ============================================================
# local_secure: 画像をpublic/uploads/ではなくstorage/uploads/に保存する（本番環境と統一）
STORAGE_TYPE=local_secure
STORAGE_IMAGE_TYPE=local_secure
STORAGE_ATTACHMENT_TYPE=local_secure

# ============================================================
# メール設定
# ============================================================
MAIL_DRIVER=smtp
MAIL_FROM_NAME="shin·on Wiki by BookStack"
MAIL_FROM=bookstack@example.com
# 「設定 > メンテナンス」の「テストメール送信」で動作確認できます。
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# ============================================================
# shin•on Portal JWT 連携設定
# ============================================================
AUTH_METHOD=portal_jwt
PORTAL_JWT_ISSUER=https://portal.shin-on1981.com
PORTAL_JWT_AUDIENCE=shin-on-apps
# 開発環境用
PORTAL_JWKS_URL=http://host.docker.internal/api/jwks/
PORTAL_LOGIN_URL=http://localhost/login/
PORTAL_LOGOUT_URL=http://localhost/logout/
# 本番環境用
# PORTAL_JWKS_URL=https://portal.shin-on1981.com/api/jwks/
# PORTAL_LOGIN_URL=https://portal.shin-on1981.com/login/
# PORTAL_LOGOUT_URL=https://portal.shin-on1981.com/logout/

# ============================================================
# Dropboxバックアップ設定
# ============================================================
# Dropbox App Console で取得: https://www.dropbox.com/developers/apps
# 必要な権限: files.content.write, files.content.read, account_info.read
# リダイレクトURIに登録: ${APP_URL}/auth/dropbox/callback
DROPBOX_CLIENT_ID=your_dropbox_app_key
DROPBOX_CLIENT_SECRET=your_dropbox_app_secret
DROPBOX_REDIRECT_URI="${APP_URL}/auth/dropbox/callback"
DROPBOX_BACKUP_FOLDER=/shin-on_wiki-backup
DROPBOX_ACCESS_TOKEN_LIFETIME=14400
BACKUP_TIMEZONE=Asia/Tokyo
BACKUP_RETENTION_DAYS=30
