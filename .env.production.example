# shin·on Wiki by BookStack - 本番環境設定
# ==============================================================
#
# 本番環境用の設定ファイルです。
# このファイルを .env にコピーして、本番サーバーの値に更新してください。
#
# 重要事項:
# - すべてのプレースホルダー (YOUR_*, CHANGE_THIS_*) を実際の値に置換
# - このファイルを安全に保管し、バージョン管理システムにコミットしない
# - ファイルパーミッションを 600 に設定 (所有者のみ読み取り可能)

# ==============================================================
# アプリケーション設定
# ==============================================================

# 環境: 本番サーバーでは必ず 'production' にする
APP_ENV=production

# デバッグモード: セキュリティのため本番環境では必ず false にする
APP_DEBUG=false

# アプリケーションキー: php artisan key:generate で生成
# 重要: 自動生成されるため、このプレースホルダーは使用しないこと
APP_KEY=

# アプリケーションURL: 本番環境のドメインURL
# 重要: 必ず HTTPS を使用 (LINE WORKS SSO に必須)
# 例: https://wiki.yourcompany.com
APP_URL=https://your-domain.com

# アプリケーション言語
APP_LANG=ja
APP_AUTO_LANG_PUBLIC=true
APP_TIMEZONE=Asia/Tokyo

# ==============================================================
# データベース設定
# ==============================================================

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=shin_on_wiki
DB_USERNAME=bookstack
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# ==============================================================
# メール設定
# ==============================================================

# メールドライバー: smtp または sendmail
MAIL_DRIVER=smtp

# メール送信元情報
MAIL_FROM_NAME="shin·on Wiki by BookStack"
MAIL_FROM=noreply@your-domain.com

# SMTP設定
# SMTPサーバーの詳細情報に更新してください
MAIL_HOST=smtp.your-mail-provider.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls

# ==============================================================
# LINE WORKS OpenID Connect (OIDC) 認証
# ==============================================================

# 認証方法
AUTH_METHOD=oidc

# OIDCプロバイダー名
OIDC_NAME="LINE WORKS"

# 表示名の構成: ユーザー表示名の構築方法
OIDC_DISPLAY_NAME_CLAIMS=family_name|given_name

# LINE WORKS OAuth 認証情報
# 取得先: https://developers.worksmobile.com/jp/console/openapi/v2/app/list
OIDC_CLIENT_ID=YOUR_LINEWORKS_CLIENT_ID
OIDC_CLIENT_SECRET=YOUR_LINEWORKS_CLIENT_SECRET

# LINE WORKS エンドポイント
OIDC_ISSUER=https://auth.worksmobile.com
OIDC_ISSUER_DISCOVER=false
OIDC_PUBLIC_KEY=
OIDC_AUTH_ENDPOINT=https://auth.worksmobile.com/oauth2/v2.0/authorize
OIDC_TOKEN_ENDPOINT=https://auth.worksmobile.com/oauth2/v2.0/token

# 追加のOAuthスコープ
OIDC_ADDITIONAL_SCOPES=profile

# グループマッピング (この設定では使用しません)
OIDC_USER_TO_GROUPS=false
OIDC_GROUPS_CLAIM=
OIDC_REMOVE_FROM_GROUPS=false

# デバッグ: 認証問題のトラブルシューティング時のみ true に設定
OIDC_DUMP_USER_DETAILS=false

# LINE WORKS ドメイン制限
# 重要: このドメインのユーザーのみログイン可能
# 例: yourcompany または shin-on1981
LINEWORKS_DOMAIN=shin-on1981

# ==============================================================
# Dropbox OAuth 2.0 設定 (バックアップ統合)
# ==============================================================

# Dropbox OAuth 認証情報
# 取得先: https://www.dropbox.com/developers/apps
DROPBOX_CLIENT_ID=YOUR_DROPBOX_CLIENT_ID
DROPBOX_CLIENT_SECRET=YOUR_DROPBOX_CLIENT_SECRET

# Dropbox リダイレクト URI
# 重要: Dropbox App Console に登録したリダイレクト URI と完全に一致する必要があります
# 形式: ${APP_URL}/auth/dropbox/callback
# 例: https://wiki.yourcompany.com/auth/dropbox/callback
DROPBOX_REDIRECT_URI="${APP_URL}/auth/dropbox/callback"

# Dropbox バックアップ設定
DROPBOX_BACKUP_FOLDER=/shin-on_wiki-backup
DROPBOX_ACCESS_TOKEN_LIFETIME=14400

# ==============================================================
# バックアップ設定
# ==============================================================

# バックアップタイムゾーン
BACKUP_TIMEZONE=Asia/Tokyo

# バックアップ保持期間: Dropbox にバックアップを保持する日数
BACKUP_RETENTION_DAYS=30

# ==============================================================
# キャッシュ設定
# ==============================================================

# キャッシュドライバー: file, database, redis, memcached など
# デフォルト: file (ほとんどのケースに推奨)
CACHE_DRIVER=file

# セッションドライバー: file, database, redis, memcached など
# デフォルト: file
SESSION_DRIVER=file

# セッション有効期限: 分単位
SESSION_LIFETIME=120

# ==============================================================
# キュー設定
# ==============================================================

# キュー接続: sync, database, redis など
# デフォルト: sync (ジョブを即座に処理)
QUEUE_CONNECTION=sync

# ==============================================================
# ストレージ設定
# ==============================================================

# ファイルシステムドライバー: local, s3 など
# デフォルト: local
FILESYSTEM_DISK=local

# ==============================================================
# セキュリティ設定
# ==============================================================

# 許可する画像拡張子 (カンマ区切り)
# ALLOWED_SSR_HOSTS=https://your-domain.com

# ==============================================================
# オプション: 高度な設定
# ==============================================================

# ログチャンネル: single, daily, stack など
# LOG_CHANNEL=stack

# ログレベル: debug, info, notice, warning, error, critical, alert, emergency
# LOG_LEVEL=info

# ==============================================================
# 本番環境デプロイの重要な注意事項
# ==============================================================
#
# 1. HTTPS は必須
#    - LINE WORKS SSO には HTTPS が必要
#    - Let's Encrypt (certbot) を使用して無料のSSL証明書を取得
#
# 2. OAuth リダイレクト URI を更新
#    - LINE WORKS Developer Console: https://your-domain.com/oidc/callback を追加
#    - Dropbox App Console: https://your-domain.com/auth/dropbox/callback を追加
#
# 3. アプリケーションキーを生成
#    - 実行: php artisan key:generate
#    - これにより APP_KEY が自動的に設定されます
#
# 4. このファイルを安全に保管
#    - パーミッション設定: chmod 600 .env
#    - バージョン管理にコミットしない
#    - .gitignore に追加済み
#
# 5. データベースのセットアップ
#    - データベース作成: shin_on_wiki
#    - ユーザー作成: bookstack
#    - 強力なランダムパスワードを使用
#
# 6. デプロイ後
#    - キャッシュクリア: php artisan cache:clear
#    - 設定最適化: php artisan config:cache
#    - ルート最適化: php artisan route:cache
#    - ビュー最適化: php artisan view:cache
#
# 7. ファイルパーミッション
#    - storage/: 775, 所有者: www-data
#    - bootstrap/cache/: 775, 所有者: www-data
#    - public/uploads/: 775, 所有者: www-data
#
# 8. 監視
#    - ログ確認: storage/logs/laravel.log
#    - ディスク容量監視: du -sh public/uploads
#    - 定期的にバックアップをテスト
#
# ==============================================================
# サポート
# ==============================================================
#
# ドキュメント:
# - デプロイガイド: claude/docs/DEPLOYMENT.md
# - システム要件: claude/docs/SYSTEM_REQUIREMENTS.md
# - バックアップ・リストア: claude/docs/BACKUP_RESTORE.md
# - LINE WORKS SSO: claude/docs/LINEWORKS_SSO_SETUP.md
#
# ==============================================================
