# ==============================================================
# shin·on Wiki by BookStack - Apache VirtualHost 設定
# ==============================================================
#
# このファイルには2種類の設定例が含まれています:
#   A. 直接デプロイ用 (Apacheから直接PHPファイルを実行)
#   B. Dockerリバースプロキシ用 (推奨) - 複数アプリケーション対応
#
# 運用方法に応じて適切な設定を選択してください。
#
# ==============================================================

# ==============================================================
# A. 直接デプロイ用設定
# ==============================================================
#
# Ubuntu上でApache + PHP-FPMを使用した従来型のデプロイ用設定です。
#
# インストール手順:
# 1. このセクションをコピーして設定ファイルを作成:
#    sudo cp apache-vhost.conf.example /etc/apache2/sites-available/shin-on_wiki.conf
#
# 2. ファイルを編集してプレースホルダーを置き換え:
#    - your-domain.com → 実際のドメイン名
#    - admin@your-domain.com → 管理者メールアドレス
#
# 3. 必要なApacheモジュールを有効化:
#    sudo a2enmod rewrite headers ssl
#
# 4. サイトを有効化:
#    sudo a2ensite shin-on_wiki
#
# 5. Apache設定をテスト:
#    sudo apache2ctl configtest
#
# 6. Apacheを再起動:
#    sudo systemctl reload apache2
#
# 7. Let's Encrypt で SSL をセットアップ:
#    sudo certbot --apache -d your-domain.com
#
# ==============================================================

# --------------------------------------------------------------
# HTTP VirtualHost (ポート 80) - 直接デプロイ用
# --------------------------------------------------------------

<VirtualHost *:80>
    # サーバー設定
    ServerName your-domain.com
    ServerAlias www.your-domain.com
    ServerAdmin admin@your-domain.com

    # ドキュメントルート
    # 重要: 必ず 'public' ディレクトリを指定
    DocumentRoot /var/www/shin-on_wiki/public

    # ディレクトリ設定
    <Directory /var/www/shin-on_wiki/public>
        # セキュリティのためディレクトリリスティングを無効化
        Options -Indexes +FollowSymLinks

        # .htaccess による設定上書きを許可
        AllowOverride All

        # アクセス制御
        Require all granted

        # セキュリティヘッダー
        Header always set X-Frame-Options "SAMEORIGIN"
        Header always set X-Content-Type-Options "nosniff"
        Header always set X-XSS-Protection "1; mode=block"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
    </Directory>

    # 機密ディレクトリへのアクセスを制限
    <Directory /var/www/shin-on_wiki/storage>
        Require all denied
    </Directory>

    <Directory /var/www/shin-on_wiki/bootstrap/cache>
        Require all denied
    </Directory>

    # アップロードファイルへのアクセスを許可
    <Directory /var/www/shin-on_wiki/public/uploads>
        Options -Indexes
        Require all granted
    </Directory>

    # ログファイル
    ErrorLog ${APACHE_LOG_DIR}/shin-on_wiki-error.log
    CustomLog ${APACHE_LOG_DIR}/shin-on_wiki-access.log combined
    LogLevel warn
</VirtualHost>

# ==============================================================
# B. Dockerリバースプロキシ用設定 (推奨)
# ==============================================================
#
# この設定は、ホストOS上のApacheがDockerコンテナへリクエストを
# プロキシする構成です。同一サーバーで複数のWEBアプリケーションを
# Docker運用する場合に推奨されます。
#
# アーキテクチャ:
#   インターネット → Apache (SSL終端) → Dockerコンテナ (HTTP)
#
# 必要なApacheモジュール:
#   sudo a2enmod proxy proxy_http ssl headers rewrite
#
# 設定手順:
# 1. 以下の設定をコピーして各アプリケーション用の設定ファイルを作成
# 2. プレースホルダーを置き換え (ドメイン、ポート番号)
# 3. Let's Encrypt で SSL証明書を取得
# 4. サイトを有効化してApacheを再起動
#
# ==============================================================

# --------------------------------------------------------------
# 単一アプリケーション用リバースプロキシ設定
# --------------------------------------------------------------
#
# アプリケーションが1つだけの場合の設定例
#

# HTTP → HTTPS リダイレクト
<VirtualHost *:80>
    ServerName wiki.example.com
    ServerAdmin admin@example.com

    # すべてのリクエストをHTTPSにリダイレクト
    Redirect permanent / https://wiki.example.com/

    ErrorLog ${APACHE_LOG_DIR}/wiki-redirect-error.log
    CustomLog ${APACHE_LOG_DIR}/wiki-redirect-access.log combined
</VirtualHost>

# HTTPS リバースプロキシ
<VirtualHost *:443>
    ServerName wiki.example.com
    ServerAdmin admin@example.com

    # SSL設定 (Let's Encrypt)
    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/wiki.example.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/wiki.example.com/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    # リバースプロキシ設定
    # Dockerコンテナのポート8083へプロキシ
    ProxyPreserveHost On
    ProxyPass / http://localhost:8083/
    ProxyPassReverse / http://localhost:8083/

    # WebSocketサポート (必要な場合)
    # ProxyPass /ws ws://localhost:8083/ws
    # ProxyPassReverse /ws ws://localhost:8083/ws

    # セキュリティヘッダー
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # プロキシヘッダーの転送
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    # ログファイル
    ErrorLog ${APACHE_LOG_DIR}/wiki-ssl-error.log
    CustomLog ${APACHE_LOG_DIR}/wiki-ssl-access.log combined
    LogLevel warn
</VirtualHost>

# --------------------------------------------------------------
# 複数アプリケーション用リバースプロキシ設定
# --------------------------------------------------------------
#
# 同じサーバーで複数のWEBアプリケーションをDocker運用する場合の設定例
#
# --------------------------------------------------------------
# 実運用例: shin-on.mydns.jp サブドメイン構成
# --------------------------------------------------------------
#
# MyDNS で取得したドメインにサブドメインを設定:
#   - wiki.shin-on.mydns.jp → shin-on_wiki (ポート 8083)
#   - db.shin-on.mydns.jp   → shin-on (ポート 8081)
#
# MyDNS側設定:
#   1. https://www.mydns.jp/ にログイン
#   2. DOMAIN INFO → 対象ドメイン選択
#   3. HOSTNAME に「wiki」「db」を追加（Aレコード、IPは自動）
#
# 各アプリケーションの.envで設定:
#   shin-on_wiki: COMPOSE_PROJECT_NAME=shin-on_wiki, APP_PORT=8083, APP_URL=https://wiki.shin-on.mydns.jp
#   shin-on:      COMPOSE_PROJECT_NAME=shin-on, APP_PORT=8081, APP_URL=https://db.shin-on.mydns.jp
#
# --------------------------------------------------------------
# 汎用例
# --------------------------------------------------------------
#
# 前提条件:
#   - App1: wiki.example.com → localhost:8083
#   - App2: app2.example.com → localhost:8084
#   - App3: app3.example.com → localhost:8085
#
# 各アプリケーションの.envで設定:
#   App1: COMPOSE_PROJECT_NAME=shin-on_wiki, APP_PORT=8083
#   App2: COMPOSE_PROJECT_NAME=example-app2, APP_PORT=8084
#   App3: COMPOSE_PROJECT_NAME=example-app3, APP_PORT=8085
#

# ====================
# App1: wiki.example.com (shin-on_wiki)
# ====================

# HTTP → HTTPS リダイレクト
<VirtualHost *:80>
    ServerName wiki.example.com
    Redirect permanent / https://wiki.example.com/
    ErrorLog ${APACHE_LOG_DIR}/wiki-redirect-error.log
    CustomLog ${APACHE_LOG_DIR}/wiki-redirect-access.log combined
</VirtualHost>

# HTTPS リバースプロキシ
<VirtualHost *:443>
    ServerName wiki.example.com
    ServerAdmin admin@example.com

    # SSL設定
    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/wiki.example.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/wiki.example.com/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    # App1へのリバースプロキシ (ポート8083)
    ProxyPreserveHost On
    ProxyPass / http://localhost:8083/
    ProxyPassReverse / http://localhost:8083/

    # セキュリティヘッダー
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # プロキシヘッダーの転送
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    # ログファイル
    ErrorLog ${APACHE_LOG_DIR}/wiki-ssl-error.log
    CustomLog ${APACHE_LOG_DIR}/wiki-ssl-access.log combined
    LogLevel warn
</VirtualHost>

# ====================
# App2: app2.example.com
# ====================

# HTTP → HTTPS リダイレクト
<VirtualHost *:80>
    ServerName app2.example.com
    Redirect permanent / https://app2.example.com/
    ErrorLog ${APACHE_LOG_DIR}/app2-redirect-error.log
    CustomLog ${APACHE_LOG_DIR}/app2-redirect-access.log combined
</VirtualHost>

# HTTPS リバースプロキシ
<VirtualHost *:443>
    ServerName app2.example.com
    ServerAdmin admin@example.com

    # SSL設定
    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/app2.example.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/app2.example.com/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    # App2へのリバースプロキシ (ポート8084)
    ProxyPreserveHost On
    ProxyPass / http://localhost:8084/
    ProxyPassReverse / http://localhost:8084/

    # セキュリティヘッダー
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # プロキシヘッダーの転送
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    # ログファイル
    ErrorLog ${APACHE_LOG_DIR}/app2-ssl-error.log
    CustomLog ${APACHE_LOG_DIR}/app2-ssl-access.log combined
    LogLevel warn
</VirtualHost>

# ====================
# App3: app3.example.com
# ====================

# HTTP → HTTPS リダイレクト
<VirtualHost *:80>
    ServerName app3.example.com
    Redirect permanent / https://app3.example.com/
    ErrorLog ${APACHE_LOG_DIR}/app3-redirect-error.log
    CustomLog ${APACHE_LOG_DIR}/app3-redirect-access.log combined
</VirtualHost>

# HTTPS リバースプロキシ
<VirtualHost *:443>
    ServerName app3.example.com
    ServerAdmin admin@example.com

    # SSL設定
    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/app3.example.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/app3.example.com/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    # App3へのリバースプロキシ (ポート8085)
    ProxyPreserveHost On
    ProxyPass / http://localhost:8085/
    ProxyPassReverse / http://localhost:8085/

    # セキュリティヘッダー
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # プロキシヘッダーの転送
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    # ログファイル
    ErrorLog ${APACHE_LOG_DIR}/app3-ssl-error.log
    CustomLog ${APACHE_LOG_DIR}/app3-ssl-access.log combined
    LogLevel warn
</VirtualHost>

# ==============================================================
# 高度な設定オプション (オプション)
# ==============================================================

# --------------------------------------------------------------
# 圧縮 (Gzip)
# --------------------------------------------------------------
# パフォーマンス向上のため圧縮を有効化
# 必要: mod_deflate
#
# <IfModule mod_deflate.c>
#     AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
#     AddOutputFilterByType DEFLATE application/javascript application/json
#     AddOutputFilterByType DEFLATE image/svg+xml
# </IfModule>

# --------------------------------------------------------------
# ブラウザキャッシュ
# --------------------------------------------------------------
# 静的ファイルのキャッシュヘッダーを設定
# 必要: mod_expires
#
# <IfModule mod_expires.c>
#     ExpiresActive On
#
#     # 画像
#     ExpiresByType image/jpeg "access plus 1 year"
#     ExpiresByType image/gif "access plus 1 year"
#     ExpiresByType image/png "access plus 1 year"
#     ExpiresByType image/webp "access plus 1 year"
#     ExpiresByType image/svg+xml "access plus 1 year"
#     ExpiresByType image/x-icon "access plus 1 year"
#
#     # CSSとJavaScript
#     ExpiresByType text/css "access plus 1 month"
#     ExpiresByType application/javascript "access plus 1 month"
#
#     # フォント
#     ExpiresByType font/ttf "access plus 1 year"
#     ExpiresByType font/otf "access plus 1 year"
#     ExpiresByType font/woff "access plus 1 year"
#     ExpiresByType font/woff2 "access plus 1 year"
#     ExpiresByType application/font-woff "access plus 1 year"
#
#     # HTMLはキャッシュしない
#     ExpiresByType text/html "access plus 0 seconds"
# </IfModule>

# --------------------------------------------------------------
# プロキシタイムアウト設定
# --------------------------------------------------------------
# 長時間実行されるリクエスト用のタイムアウト設定
#
# <IfModule mod_proxy.c>
#     # タイムアウト時間を5分に設定
#     ProxyTimeout 300
#
#     # アップロードファイルサイズの制限を緩和
#     # (Dockerコンテナ側のPHP設定と合わせる)
#     LimitRequestBody 134217728  # 128MB
# </IfModule>

# --------------------------------------------------------------
# IP制限 (管理画面へのアクセス制限)
# --------------------------------------------------------------
# 特定のIPアドレスからのみアクセスを許可
#
# <Location /settings>
#     # 社内IPからのみアクセス可能
#     Require ip 192.168.1.0/24
#     Require ip 203.0.113.0/24
# </Location>

# ==============================================================
# 必要なApacheモジュール
# ==============================================================
#
# 直接デプロイ用 (必須):
#   - mod_rewrite     : URL書き換え (Laravel に必須)
#   - mod_headers     : HTTPヘッダー操作
#   - mod_ssl         : SSL/TLS サポート
#
# Dockerリバースプロキシ用 (必須):
#   - mod_proxy       : プロキシ機能
#   - mod_proxy_http  : HTTPプロキシ
#   - mod_headers     : HTTPヘッダー操作
#   - mod_ssl         : SSL/TLS サポート
#
# 有効化コマンド:
#   sudo a2enmod proxy proxy_http headers ssl rewrite
#
# オプションモジュール (推奨):
#   - mod_deflate     : 圧縮
#   - mod_expires     : ブラウザキャッシュ
#   - mod_security2   : Web Application Firewall
#   - mod_evasive     : DoS 保護
#
# オプションモジュール有効化:
#   sudo a2enmod deflate expires
#
# ==============================================================

# ==============================================================
# Docker + リバースプロキシ デプロイチェックリスト
# ==============================================================
#
# 1. [ ] 各アプリケーションの.envファイルを設定
#        - COMPOSE_PROJECT_NAME (重複しないこと)
#        - APP_PORT (重複しないポート番号)
#        - APP_URL (実際のドメイン)
#
# 2. [ ] 各アプリケーションのDockerコンテナを起動
#        cd /var/www/app1
#        docker compose -f docker-compose.production.yml up -d
#
# 3. [ ] 必要なApacheモジュールを有効化
#        sudo a2enmod proxy proxy_http headers ssl rewrite
#
# 4. [ ] Apache VirtualHost設定ファイルを作成
#        sudo nano /etc/apache2/sites-available/multi-apps.conf
#        (この設定ファイルの内容を使用)
#
# 5. [ ] プレースホルダーを実際の値に置き換え
#        - example.com → 実際のドメイン
#        - ポート番号 (8083, 8084, 8085)
#
# 6. [ ] サイト設定を有効化
#        sudo a2ensite multi-apps
#
# 7. [ ] Apache設定をテスト
#        sudo apache2ctl configtest
#
# 8. [ ] Apacheを再起動
#        sudo systemctl restart apache2
#
# 9. [ ] 各ドメインのSSL証明書を取得
#        sudo certbot --apache -d wiki.example.com
#        sudo certbot --apache -d app2.example.com
#        sudo certbot --apache -d app3.example.com
#
# 10. [ ] OAuth設定を更新
#         - LINE WORKS: リダイレクトURIを各ドメインに更新
#         - Dropbox: リダイレクトURIを各ドメインに更新
#
# 11. [ ] HTTPS アクセスをテスト
#         - https://wiki.example.com
#         - https://app2.example.com
#         - https://app3.example.com
#
# 12. [ ] 各アプリケーションのログを監視
#         docker compose -f docker-compose.production.yml logs -f
#         sudo tail -f /var/log/apache2/*-error.log
#
# ==============================================================

# ==============================================================
# トラブルシューティング
# ==============================================================
#
# よくある問題:
#
# 1. プロキシ接続エラー "Service Unavailable"
#    - Dockerコンテナが起動しているか確認:
#      docker ps | grep shin-on_wiki
#    - コンテナのポートが正しいか確認:
#      docker compose -f docker-compose.production.yml ps
#    - コンテナログを確認:
#      docker compose -f docker-compose.production.yml logs app
#
# 2. SSL証明書エラー
#    - mod_ssl が有効か確認: sudo a2enmod ssl
#    - 証明書ファイルが存在するか確認:
#      ls -l /etc/letsencrypt/live/wiki.example.com/
#    - 証明書を更新: sudo certbot renew
#
# 3. プロキシモジュールエラー
#    - プロキシモジュールを有効化:
#      sudo a2enmod proxy proxy_http
#    - Apacheを再起動: sudo systemctl restart apache2
#
# 4. ポート競合エラー
#    - ポート使用状況を確認: sudo lsof -i :8083
#    - .envのAPP_PORTを変更
#    - VirtualHost設定のProxyPassポートを変更
#
# 5. リダイレクトループ
#    - アプリケーションの.envファイルでAPP_URLが正しいか確認
#    - APP_URL=https://wiki.example.com (HTTPSで、ドメイン名)
#    - ProxyPreserveHost On が設定されているか確認
#
# 6. WebSocketが動作しない
#    - mod_proxy_wstunnel を有効化:
#      sudo a2enmod proxy_wstunnel
#    - ProxyPass /ws ws://localhost:8083/ws を追加
#
# ==============================================================

# ==============================================================
# ログ記録と監視
# ==============================================================
#
# Apacheログを表示:
#   # アクセスログ
#   sudo tail -f /var/log/apache2/wiki-ssl-access.log
#
#   # エラーログ
#   sudo tail -f /var/log/apache2/wiki-ssl-error.log
#
#   # すべてのアプリケーションのエラーログ
#   sudo tail -f /var/log/apache2/*-error.log
#
# Dockerコンテナログを表示:
#   cd /var/www/shin-on_wiki
#   docker compose -f docker-compose.production.yml logs -f app
#
# ログ分析:
#   # プロキシエラーを検索
#   sudo grep "proxy" /var/log/apache2/wiki-ssl-error.log
#
#   # 500エラーを検索
#   sudo grep " 500 " /var/log/apache2/wiki-ssl-access.log
#
#   # 404エラーを検索
#   sudo grep " 404 " /var/log/apache2/wiki-ssl-access.log
#
# ==============================================================

# ==============================================================
# セキュリティ推奨事項
# ==============================================================
#
# 1. HTTPS のみ使用
#    - 常に SSL/TLS を使用
#    - HSTS ヘッダーを有効化
#
# 2. ファイアウォールを設定
#    - sudo ufw allow 80/tcp
#    - sudo ufw allow 443/tcp
#    - sudo ufw enable
#    - Dockerポート(8083-8085)は外部公開しない
#
# 3. Dockerコンテナポートを外部公開しない
#    - docker-compose.production.yml のポート設定:
#      ports: - '127.0.0.1:8083:80'  # ローカルホストのみ
#    - または: ports: - '8083:80'  # デフォルトで内部のみ
#
# 4. ソフトウェアを最新に保つ
#    - sudo apt update && sudo apt upgrade
#    - docker compose pull
#
# 5. ログを監視
#    - 自動ログ監視を設定
#    - fail2ban を使用してブルートフォース攻撃を防止
#
# 6. 定期的なバックアップ
#    - 各アプリケーションで自動バックアップを設定
#    - cronで定期バックアップをスケジュール
#
# 7. ModSecurity を使用 (オプション)
#    - Web Application Firewall
#    - sudo apt install libapache2-mod-security2
#    - sudo a2enmod security2
#
# ==============================================================

# ==============================================================
# サポートとドキュメント
# ==============================================================
#
# BookStack ドキュメント:
#   https://www.bookstackapp.com/docs/
#
# Apache ドキュメント:
#   https://httpd.apache.org/docs/2.4/
#
# Docker ドキュメント:
#   https://docs.docker.com/
#
# Let's Encrypt:
#   https://letsencrypt.org/docs/
#
# プロジェクトドキュメント:
#   /var/www/shin-on_wiki/claude/docs/
#   - DEPLOYMENT_DOCKER.md (Docker運用ガイド)
#   - DEPLOYMENT.md (従来型デプロイメントガイド)
